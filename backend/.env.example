# PointX Backend Environment Configuration Example
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pointx_db
JWT_SECRET=pointx_development_jwt_secret_key_example_change_in_prod
JWT_EXPIRES_IN=7d

# Brevo Transactional Email Service
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@pointx.gg
BREVO_SENDER_NAME=PointX Esports Security

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pointx

CLIENT_URL=http://localhost:5173
