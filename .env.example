# ==============================================================================
# PointX Esports Operating System — Render Production Environment Configuration
# ==============================================================================

# Node Environment & Port (Render dynamically sets PORT, defaults to 10000 on Render)
NODE_ENV=production
PORT=10000

# MongoDB Database Connection URI (MongoDB Atlas connection string)
# Format: mongodb+srv://<db_username>:<db_password>@cluster0.xxxxxx.mongodb.net/pointx?retryWrites=true&w=majority
MONGODB_URI=

# JSON Web Token Secret & Expiration
# Generate a 64+ char random string (e.g., openssl rand -base64 32)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Super Admin Bootstrap Credentials (Used to seed or authenticate super admin)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=

# Brevo (formerly Sendinblue) Transactional Email Service
# Get API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=support@pointx.gg
BREVO_SENDER_NAME=PointX Esports Arena

# Cloudinary Media Storage (Automated Image Optimization & CDN)
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pointx

# Frontend / Client Origin URL (Only needed if deploying frontend as a separate service)
# Example: https://pointx.onrender.com
FRONTEND_URL=
CLIENT_URL=

# Optional: Frontend API Base URL (Only needed if frontend is deployed separately from backend)
# Example: https://pointx-backend.onrender.com/api
# VITE_API_BASE_URL=
